rules_version = '2';

// FidanCari erişim kuralları.
//
// Ortak defter modeli: tüm veri tek bir belgenin altında yaşar
// (`isletmeler/ortak` — bkz. `Isletme.ortakId`) ve uygulamayı kullanan herkes
// **aynı** defteri görür. İki kişi aynı işletmenin kayıtlarını tutuyor; veri
// kişiye değil işletmeye ait.
//
// Erişimin tek koşulu açık bir oturum: giriş yapan hesap defterin tamamını
// görür. Bunun güvenli olması, hesapların yalnızca elle açılmasına dayanıyor:
//
//   Firebase Console → Authentication → Users → "Add user"
//     (e-posta + şifre yazılır, kullanıcıya verilir)
//
//   Firebase Console → Authentication → Settings → User actions →
//     "Enable create (sign-up)" **kapalı**
//
// İkinci madde şart: açık kalırsa uygulamanın API anahtarını eline geçiren
// biri kendine hesap açıp deftere girebilir. Uygulamanın içinde kayıt ekranı
// yok, ama Firebase'in kayıt uç noktası sağlayıcı açıkken herkese açıktır.
//
// Bkz. KURALLAR.md §4.1

service cloud.firestore {
  match /databases/{database}/documents {

    // Giriş yapmış hesap ortak defterin tamamına erişir.
    match /isletmeler/{isletmeId} {
      allow read, write: if request.auth != null;

      // cariler, cariler/*/islemler, urunler — hepsi aynı kurala tabi.
      match /{belgeYolu=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Yukarıda eşleşmeyen her yol reddedilir.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
